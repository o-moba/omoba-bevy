{
  "schema_version": 1,
  "about": "Every UI screen Omoba has, how a player reaches it and how scripts/capture_ui_audit.py captures it. Add a screen here when you add one to the game; `capture_ui_audit.py --check` and scripts/test_ui_screen_map.py flag screens and harness frames that are not mapped.",
  "profiles": {
    "desktop": [
      1280,
      720
    ],
    "phone": [
      844,
      390
    ]
  },
  "runs": {
    "shell": {
      "area": "01-menus",
      "harness": "client/src/qa/frontend_qa.rs",
      "server": "dev",
      "env": {
        "OMOBA_FRONTEND_QA_OUTPUT": "{out}",
        "OMOBA_QA_CLEAN_FRAME": "1"
      },
      "note": "Front-end shell screens driven directly; searching/loading/post-match have no real match behind them.",
      "sources": [
        "client/src/qa/frontend_qa.rs"
      ]
    },
    "flow": {
      "area": "02-matchmaking",
      "harness": "client/src/qa/frontend_flow_qa.rs",
      "server": "practice",
      "env": {
        "OMOBA_FRONTEND_QA_OUTPUT": "{out}",
        "OMOBA_FRONTEND_QA_FLOW": "1"
      },
      "note": "Real button flow into a practice match: draft, countdown, loading, first in-match frame.",
      "sources": [
        "client/src/qa/frontend_flow_qa.rs"
      ]
    },
    "match": {
      "area": "03-in-match-hud",
      "harness": "client/src/qa/beta_ui_qa.rs",
      "server": "dev",
      "env": {
        "OMOBA_VISUAL_QA_DIR": "{out}",
        "OMOBA_VISUAL_QA_SCENARIO": "beta-ui",
        "OMOBA_BETA_UI_EDGE": "1",
        "OMOBA_BETA_UI_CLASS": "mage",
        "OMOBA_QA_TEAM": "green",
        "OMOBA_VISUAL_QA_TIMEOUT": "220"
      },
      "phone_env": {
        "OMOBA_BETA_UI_EDGE": "0"
      },
      "note": "HUD, help, shop and a real purchase; result, target frames and scoreboard use labelled fixtures. Phones run without the edge pass: in 0.25.0 it stops on its radial-geometry check.",
      "sources": [
        "client/src/qa/beta_ui_qa.rs",
        "client/src/qa/edge_hud_qa.rs"
      ],
      "ignore": {
        "14-utilities-acknowledged-{h}p.png": "phone-only edge frame; the phone edge pass is off (see gap phone-target-scoreboard)"
      }
    },
    "social": {
      "area": "04-social-in-match",
      "harness": "client/src/qa/social_qa.rs",
      "server": "practice",
      "env": {
        "OMOBA_SOCIAL_QA_OUTPUT": "{out}"
      },
      "phone_env": {
        "OMOBA_SOCIAL_QA_SKILL_HELP": "1"
      },
      "note": "Chat, reaction wheel, confirmed reaction; phone adds the skill description on hold.",
      "sources": [
        "client/src/qa/social_qa.rs"
      ]
    },
    "career": {
      "area": "05-career",
      "harness": "client/src/qa/career_visual_qa.rs",
      "server": null,
      "env": {
        "OMOBA_CAREER_QA_OUTPUT": "{out}"
      },
      "note": "Profile, friends, history, match detail, account and devices with labelled fixture data.",
      "sources": [
        "client/src/qa/career_visual_qa.rs"
      ]
    },
    "supporter": {
      "area": "06-supporter",
      "harness": "client/src/qa/supporter.rs",
      "server": null,
      "env": {
        "OMOBA_SUPPORTER_QA_DIR": "{out}"
      },
      "note": "Supporter aura panel; the harness uses its own fixed viewport sizes.",
      "sources": [
        "client/src/qa/supporter.rs"
      ]
    },
    "offline": {
      "area": "07-offline-practice",
      "harness": "client/src/qa/offline_qa.rs",
      "server": null,
      "env": {
        "OMOBA_OFFLINE_SMOKE_DIR": "{out}"
      },
      "note": "Offline practice from Home: hero picker, match, target, game menu, settings. Logical size without a scale override, so HiDPI displays give 2x frames; its pass flag also checks the saved server endpoint.",
      "sources": [
        "client/src/qa/offline_qa.rs"
      ]
    }
  },
