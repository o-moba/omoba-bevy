/target
assets/
# Re-include the client assets dir so the committed avatar roster stays versioned,
# while everything else under client/assets/ (e.g. downloaded/) remains ignored.
!client/assets/
client/assets/*
!client/assets/avatars/
!client/assets/bosses/
!client/assets/minions/
!client/assets/config/
!client/assets/sprites/
!client/assets/presentation2d/
!client/assets/world2d/
!client/assets/verdant/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/omoba-sprite-character/
!.claude/skills/omoba-sprite-character/**
.claude/rules/
.claude/rules/**
.cursor/*
.cursor/rules/
.cursor/rules/**
.cursor/agents/
.cursor/agents/**
.codex
.agent
.tasks
AGENTS.md
CLAUDE.md
# docs/tasks: ignore by default; whitelist canonical markdown so deliverables stay versioned.
docs/*
!docs/features.md
!docs/playtest-script.md
!docs/bug-report-template.md
!docs/mvp-scope-and-limitations.md
!docs/progress/
!docs/progress/**

tasks/*
!tasks/MVP-CHECKLIST.md
# Runtime-synced arena avatars (arena-sync output) — not committed content.
client/assets/avatars/osa-*.glb
client/assets/avatars/osa-*.png
client/assets/avatars/osa-*.jpg

# Local dev override for ekza-bevy-sdk (patch to on-disk checkout)
.cargo/
