# Preserve captured command output, including final blank lines.
.agent/tasks/REPO-AUDIT-2026-09-05/raw/*.log whitespace=-blank-at-eof

# Preserve verbatim upstream license texts, including their trailing spaces.
LICENSES/*.txt whitespace=-blank-at-eol
*/LICENSE whitespace=-blank-at-eol

# Shipped assets are byte-exact: the asset review gate pins their hashes, so a
# Windows checkout must not rewrite line endings.
client/assets/** -text
