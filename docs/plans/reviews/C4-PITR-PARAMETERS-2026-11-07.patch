@@ -0,0 +1,479 @@
+#!/usr/bin/env python3
+"""C4: physical/WAL recovery through pgBackRest; called by ru_backup (LR-03).
+This module never restarts/configures PostgreSQL, provisions credentials or restores
+into an existing data directory. Actual host installation is a separate action.
+"""
+from __future__ import annotations
+
+import configparser
+import contextlib
+import fcntl
+import json
+import os
+import re
+import shlex
+import shutil
+import stat
+import subprocess
+import tempfile
+import time
+import uuid
+from pathlib import Path
+
+import ru_backup as rb
+
+STANZA = 'omoba-ru'
+CONFIG = '/etc/pgbackrest/omoba-ru.conf'
+RUNTIME = '/var/lib/omoba-ru-pitr'
+CHECK_MAX_AGE = 300
+BACKUP_MAX_AGE = 26 * 3600
+DRILL_MAX_AGE = 35 * 86400
+FULL_INTERVAL = 7 * 86400
+DRILL_TIMEOUT = 3600
+SAFE_PATH = re.compile(r'/[A-Za-z0-9_./-]+')
+GLOBAL_KEYS = frozenset('repo1-type repo1-path repo1-cipher-type repo1-cipher-pass repo1-retention-full repo1-retention-diff repo1-sftp-host repo1-sftp-host-port repo1-sftp-host-user repo1-sftp-private-key-file repo1-sftp-public-key-file repo1-sftp-host-key-check-type repo1-sftp-host-key-hash-type repo1-sftp-known-host repo1-s3-bucket repo1-s3-endpoint repo1-s3-region repo1-s3-key repo1-s3-key-secret repo1-storage-verify-tls repo1-storage-port repo1-s3-uri-style archive-async archive-check archive-copy archive-mode-check archive-timeout process-max start-fast compress-type compress-level io-timeout protocol-timeout db-timeout lock-path log-path spool-path log-level-file'.split())
+PG_KEYS = frozenset(('pg1-path','pg1-socket-path','pg1-port','pg1-user'))
+SECRET_KEYS = ('repo1-cipher-pass','repo1-s3-key','repo1-s3-key-secret')
+RECOVERY_KEYS = frozenset(('restore_command','recovery_target_name','recovery_target_action','recovery_target_timeline','recovery_target_inclusive'))
+RECOVERY_LIMITS = {'max_connections':('max_connections',1),
+    'max_worker_processes':('max_worker_processes',0),
+    'max_wal_senders':('max_wal_senders',0),
+    'max_prepared_transactions':('max_prepared_xacts',0),
+    'max_locks_per_transaction':('max_locks_per_xact',10)}
+
+
+def required(cfg):
+    value = cfg.get('OMOBA_BACKUP_PITR_REQUIRED')
+    if value not in ('0','1'):
+        raise rb.BackupError('OMOBA_BACKUP_PITR_REQUIRED must be 0 or 1')
+    return value == '1'
+
+
+def private_file(path, label):
+    try:
+        info = Path(path).lstat()
+    except OSError:
+        return f'{label} is missing or unreadable'
+    if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) not in (0o600,0o640):
+        return f'{label} must be a regular file with mode 0600 or 0640'
+    return None
+
+
+def public_file(path, label):
+    try:
+        info = Path(path).lstat()
+    except OSError:
+        return f'{label} is missing or unreadable'
+    if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o022 or info.st_size == 0:
+        return f'{label} must be a nonempty regular file without group/world write'
+    return None
+
+
+def actor_access(path,uid,gid,bits):
+    try:
+        path=Path(path)
+        for parent in path.parents:
+            mode=parent.stat()
+            shift=6 if mode.st_uid==uid else (3 if mode.st_gid==gid else 0)
+            if not (mode.st_mode>>shift)&1:return False
+        mode=path.stat();shift=6 if mode.st_uid==uid else (3 if mode.st_gid==gid else 0)
+        return ((mode.st_mode>>shift)&bits)==bits
+    except OSError:return False
+
+
+def within(path, parent):
+    try:
+        Path(path).resolve().relative_to(Path(parent).resolve())
+        return True
+    except (OSError, ValueError):
+        return False
+
+
+def lsn(value):
+    if not re.fullmatch(r'[0-9A-F]+/[0-9A-F]+', str(value)):
+        raise rb.BackupError('invalid WAL position in PITR response')
+    high, low = str(value).split('/')
+    return (int(high,16)<<32)+int(low,16)
+
+
+class Pitr:
+    def __init__(self, cfg, now=time.time):
+        self.cfg, self.now = cfg, now
+        self.path = cfg.get('OMOBA_BACKUP_PITR_CONFIG')
+        self.runtime = Path(cfg.get('OMOBA_BACKUP_PITR_RUNTIME_DIR'))
+        self.global_options, self.pg, self.hidden = {}, {}, []
+        self.errors = []
+        if not SAFE_PATH.fullmatch(self.path or '') or '..' in Path(self.path).parts:
+            self.errors.append('PITR config path must be a plain absolute path')
+            return
+        problem = private_file(self.path,'PITR config')
+        if problem:
+            self.errors.append(problem)
+            return
+        try:
+            if Path(self.path).stat().st_size > 16_384:
+                raise ValueError('size')
+            parser = configparser.ConfigParser(interpolation=None,strict=True)
+            parser.read_string(Path(self.path).read_text())
+            if set(parser.sections()) != {'global',STANZA} or parser.defaults():
+                raise ValueError('sections')
+            self.global_options = dict(parser['global'])
+            self.pg = dict(parser[STANZA])
+        except (OSError, ValueError, configparser.Error):
+            self.errors.append('PITR config is malformed, oversized or has unexpected sections')
+            return
+        self.hidden = [self.global_options.get(key,'') for key in SECRET_KEYS]
+        self._validate()
+
+    def _validate(self):
+        g, p, errors = self.global_options, self.pg, self.errors
+        if set(g)-GLOBAL_KEYS or set(p)-PG_KEYS:
+            errors.append('PITR config contains unsupported options')
+        for name,value in {'repo1-cipher-type':'aes-256-cbc','archive-async':'n','archive-check':'y',
+                'archive-copy':'y','archive-mode-check':'y','start-fast':'y','log-level-file':'off'}.items():
+            if g.get(name) != value:
+                errors.append(f'PITR {name} must be {value}')
+        if len(g.get('repo1-cipher-pass','')) < 32 or 'CHANGE_ME' in g.get('repo1-cipher-pass',''):
+            errors.append('PITR requires a separately escrowed cipher passphrase of at least32 characters')
+        for name,lo,hi in [('repo1-retention-full',2,52),('repo1-retention-diff',1,60),
+                          ('process-max',1,2),('archive-timeout',5,60),('io-timeout',5,60)]:
+            if not re.fullmatch(r'\d+',g.get(name,'')) or not lo <= int(g.get(name,'0')) <= hi:
+                errors.append(f'PITR {name} must be between {lo} and {hi}')
+        if g.get('compress-type') not in ('gz','lz4','zst'):
+            errors.append('PITR requires explicit supported compression')
+        if not SAFE_PATH.fullmatch(str(self.runtime)) or '..' in self.runtime.parts:
+            errors.append('PITR runtime must be a plain absolute path')
+        for name in ('lock-path','log-path','spool-path'):
+            if not SAFE_PATH.fullmatch(g.get(name,'')) or not within(g.get(name,''),self.runtime):
+                errors.append(f'PITR {name} must be within its separate runtime directory')
+        for name in ('pg1-path','pg1-socket-path'):
+            if not SAFE_PATH.fullmatch(p.get(name,'')) or '..' in Path(p.get(name,'')).parts or 'CHANGE_ME' in p.get(name,''):
+                errors.append(f'PITR {name} must be a plain absolute path')
+        if p.get('pg1-path') and (within(self.runtime,p['pg1-path']) or within(p['pg1-path'],self.runtime)):
+            errors.append('PITR runtime and primary data paths must be disjoint')
+        if not re.fullmatch(r'\d{1,5}',p.get('pg1-port','')) or not 1 <= int(p.get('pg1-port','0')) <= 65535:
+            errors.append('PITR pg1-port is invalid')
+        if p.get('pg1-user') != 'postgres':
+            errors.append('PITR local peer connection must use postgres')
+        if not SAFE_PATH.fullmatch(g.get('repo1-path','')) or g.get('repo1-path') == '/' or '..' in Path(g.get('repo1-path','')).parts:
+            errors.append('PITR repository needs its own absolute non-root prefix')
+        kind=g.get('repo1-type')
+        if kind=='sftp':
+            if g.get('repo1-sftp-host-key-check-type')!='strict' or g.get('repo1-sftp-host-key-hash-type')!='sha256':
+                errors.append('PITR SFTP requires strict SHA256 host-key checking')
+            for name,private in [('repo1-sftp-private-key-file',True),('repo1-sftp-public-key-file',False),('repo1-sftp-known-host',False)]:
+                problem=(private_file if private else public_file)(g.get(name,''),name)
+                if problem:errors.append(problem)
+                if Path(g.get(name,'')).parent.resolve()!=Path(self.path).parent.resolve():errors.append(f'PITR {name} must be a direct child of the escrowed config folder')
+            if not g.get('repo1-sftp-host-user'):
+                errors.append('PITR SFTP user is unset')
+            host=g.get('repo1-sftp-host','')
+        elif kind=='s3':
+            if g.get('repo1-storage-verify-tls')!='y':errors.append('PITR S3 must verify TLS')
+            for name in ('repo1-s3-bucket','repo1-s3-region','repo1-s3-key','repo1-s3-key-secret'):
+                if not g.get(name) or 'CHANGE_ME' in g[name]:errors.append(f'PITR {name} is unset')
+            host=g.get('repo1-s3-endpoint','')
+        else:
+            errors.append('PITR requires a remote SFTP or S3 repository')
+            host=''
+        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9.-]*',host) or host in ('localhost','127.0.0.1') or host.startswith('127.') or 'CHANGE_ME' in host:
+            errors.append('PITR repository host is unset or loopback')
+
+    def problems(self):
+        problems=list(self.errors)
+        if not self.errors:
+            try:
+                parent=Path(self.path).parent;empty=parent/'empty'
+                if Path(self.path).stat().st_uid != os.geteuid() or parent.stat().st_uid != os.geteuid() or parent.stat().st_mode & 0o022:
+                    problems.append('PITR config and its folder must belong to the root coordinator and reject group/world writes')
+                if not empty.is_dir() or empty.is_symlink() or empty.stat().st_uid != os.geteuid() or empty.stat().st_mode & 0o022 or any(empty.iterdir()):
+                    problems.append('PITR include folder must be protected and empty')
+                if self.global_options.get('repo1-type')=='sftp' and Path(self.global_options['repo1-sftp-known-host']).stat().st_uid != os.geteuid():
+                    problems.append('PITR SFTP host pins must belong to the root coordinator')
+                protected={Path(self.path).resolve()}
+                if self.global_options.get('repo1-type')=='sftp':
+                    protected.update(Path(self.global_options[name]).resolve() for name in ('repo1-sftp-private-key-file','repo1-sftp-public-key-file','repo1-sftp-known-host'))
+                if not protected <= {Path(path).resolve() for path in rb.escrow_paths(self.cfg)}:
+                    problems.append('PITR protected settings/keys must all be included in the secrets escrow')
+            except (OSError,KeyError):problems.append('PITR protected config/include/host-pin paths are unavailable')
+        if not self.runtime.is_dir() or self.runtime.is_symlink():
+            problems.append('PITR runtime directory is missing or a symlink; bootstrap creates it')
+        try:
+            actor=rb.db_user(self.cfg);uid=actor.get('user',os.geteuid());gid=actor.get('group',os.getegid())
+            paths=[(self.path,4),(Path(self.path).parent/'empty',5),(self.runtime,7)]
+            if self.global_options.get('repo1-type')=='sftp':
+                paths += [(self.global_options.get(name,''),4) for name in ('repo1-sftp-private-key-file','repo1-sftp-public-key-file','repo1-sftp-known-host')]
+            if any(not actor_access(path,uid,gid,bits) for path,bits in paths):
+                problems.append('PITR peer user cannot read protected settings/keys or access its runtime directory')
+        except rb.BackupError:problems.append('PITR local peer user is unavailable')
+        try:
+            rb.exe('pgbackrest')
+            if not problems and self.version() < (2,58,0):problems.append('PITR requires pgBackRest2.58 or newer; bootstrap does not add package repositories')
+        except rb.BackupError:problems.append('pgBackRest is unavailable or its version is unsupported')
+        return [('pitr-config',value) for value in dict.fromkeys(problems)]
+
+    def ready(self):
+        problems=self.problems()
+        if problems:raise rb.BackupError('; '.join(text for _,text in problems))
+
+    def env(self):
+        return {'PATH':os.environ.get('PATH') or rb.SAFE_PATH,'LANG':'C','PGCONNECT_TIMEOUT':'5',
+                'PGPASSFILE':str(Path(self.path).parent/'empty/no-password'),'PGSERVICEFILE':'/dev/null','PGSYSCONFDIR':'/dev/null'}
+
+    def run(self,args,timeout=120,check=True,input=None):
+        try:
+            result=subprocess.run(args,input=input,text=True,capture_output=True,env=self.env(),cwd='/',
+                    timeout=timeout,**rb.db_user(self.cfg))
+        except (OSError,subprocess.TimeoutExpired):
+            raise rb.BackupError('PITR command unavailable or timed out') from None
+        if check and result.returncode:
+            text=rb.redact(rb.tail(result.stderr or result.stdout,1200),self.hidden+self.cfg.secrets())
+            raise rb.BackupError(f'PITR {Path(args[0]).name} failed: {text}')
+        return result
+
+    def engine(self,*args,timeout=120,check=True):
+        return self.run([rb.exe('pgbackrest'),'--config='+self.path,
+                '--config-include-path='+str(Path(self.path).parent/'empty'),
+                '--stanza='+STANZA,'--log-level-console=warn','--log-level-file=off',*args],timeout,check)
+
+    def version(self):
+        result=self.run([rb.exe('pgbackrest'),'version'],timeout=10)
+        match=re.search(r'pgBackRest (\d+)\.(\d+)(?:\.(\d+))?',result.stdout)
+        if not match:raise rb.BackupError('PITR cannot verify pgBackRest version')
+        return tuple(int(value or '0') for value in match.groups())
+
+    def sql(self,statement,database=None,socket=None):
+        return self.run([rb.exe('psql'),'-X','-qAt','-v','ON_ERROR_STOP=1','-w',
+            '-h',socket or self.pg['pg1-socket-path'],'-p','6545' if socket else self.pg['pg1-port'],
+            '-U','postgres','-d',database or self.cfg.database],input=statement).stdout.strip()
+
+    @property
+    def archive_command(self):
+        parts=['/usr/bin/env','-i','PATH='+rb.SAFE_PATH,'LANG=C',rb.exe('pgbackrest'),
+            '--config='+self.path,'--config-include-path='+str(Path(self.path).parent/'empty'),
+            '--stanza='+STANZA,'--log-level-file=off','archive-push']
+        return ' '.join(shlex.quote(part) for part in parts)+" '%p'"
+
+    def source(self,archive=True):
+        self.ready()
+        data=json.loads(self.sql("SELECT json_build_object('system_id',system_identifier::text,'data',current_setting('data_directory'),'version',current_setting('server_version_num'),'archive_mode',current_setting('archive_mode'),'archive_command',current_setting('archive_command'),'archive_timeout',extract(epoch FROM current_setting('archive_timeout')::interval),'archive_library',current_setting('archive_library')) FROM pg_control_system()",'postgres'))
+        if Path(data['data']).resolve()!=Path(self.pg['pg1-path']).resolve():
+            raise rb.BackupError('PITR config does not name the connected primary data directory')
+        if archive and (data['archive_mode']!='on' or data['archive_library'] or data['archive_command']!=self.archive_command or not 1 <= float(data['archive_timeout']) <= 60):
+            raise rb.BackupError('PITR primary archive settings differ from the reviewed command/60s policy; no server setting was changed')
+        return data
+
+    def info(self,allow_empty=False):
+        try:
+            entries=json.loads(self.engine('--output=json','info').stdout)
+            if len(entries)!=1 or entries[0]['name']!=STANZA or entries[0]['status']['code'] not in ((0,2) if allow_empty else (0,)):
+                raise ValueError()
+            entry=entries[0]
+            if entry['status']['code']==2 and entry.get('backup'):raise ValueError()
+            if entry['cipher']!='aes-256-cbc' or any(repo['status']['code'] not in ((0,2) if allow_empty else (0,)) for repo in entry['repo']):raise ValueError()
+            return entry
+        except (ValueError,KeyError,TypeError):
+            raise rb.BackupError('PITR remote repository is missing, untrusted, unencrypted or unhealthy') from None
+
+    def versions(self,socket=None):
+        return json.loads(self.sql("SELECT json_build_object('career',(SELECT json_agg(version ORDER BY version) FROM public.career_schema_version),'portal',(SELECT json_agg(version ORDER BY version) FROM portal.schema_version))",socket=socket))
+
+    def state_path(self):return Path(self.cfg.backup_dir)/'pitr-state.json'
+
+    def state(self):
+        try:
+            path=self.state_path()
+            if path.is_symlink() or path.stat().st_size>65536:raise ValueError()
+            value=json.loads(path.read_text())
+            if not isinstance(value,dict):raise ValueError()
+            if any(not isinstance(record,dict) for record in value.values()):raise ValueError()
+            return value
+        except FileNotFoundError:return {}
+        except (ValueError,OSError):raise rb.BackupError('PITR state is unreadable or corrupt') from None
+
+    def record(self,slot,value):
+        root=Path(self.cfg.backup_dir);root.mkdir(mode=0o700,parents=True,exist_ok=True)
+        lock=root/'pitr-state.lock'
+        fd=os.open(lock,os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW,0o600)
+        try:
+            fcntl.flock(fd,fcntl.LOCK_EX)
+            state=self.state();state[slot]=value
+            fd2,tmp=tempfile.mkstemp(prefix='.pitr-',dir=root)
+            try:
+                with os.fdopen(fd2,'w') as stream:
+                    json.dump(state,stream,sort_keys=True);stream.flush();os.fsync(stream.fileno())
+                os.replace(tmp,self.state_path())
+                parent=os.open(root,os.O_RDONLY)
+                try:os.fsync(parent)
+                finally:os.close(parent)
+            finally:
+                with contextlib.suppress(FileNotFoundError):os.unlink(tmp)
+        finally:os.close(fd)
+
+    def check(self):
+        try:
+            source=self.source();self.engine('check',timeout=120)
+            info=self.info();backups=info['backup']
+            if not backups:raise rb.BackupError('PITR has no completed physical backup')
+            last=max(backups,key=lambda value:value['timestamp']['stop'])
+            if not 0 <= self.now()-last['timestamp']['stop'] <= BACKUP_MAX_AGE:raise rb.BackupError('PITR newest physical backup is older than26h')
+            report={'ok':True,'at':rb.iso(self.now()),'label':last['label'],'backup_at':rb.iso(last['timestamp']['stop']),
+                    'system_id':source['system_id'],'cipher':info['cipher']}
+        except BaseException as error:
+            text=rb.redact(str(error),self.hidden+self.cfg.secrets())
+            self.record('last_check',{'ok':False,'at':rb.iso(self.now()),'error':text})
+            if isinstance(error,(KeyboardInterrupt,SystemExit)):raise
+            raise rb.BackupError(text) from None
+        self.record('last_check',report)
+        return report
+
+    def backup(self):
+        self.source()
+        info=self.info(allow_empty=True)
+        full=[b for b in info['backup'] if b['type']=='full']
+        kind='full' if not full or self.now()-max(b['timestamp']['stop'] for b in full)>=FULL_INTERVAL else 'diff'
+        self.engine('--type='+kind,'backup',timeout=3*3600)
+        result=self.check();result['type']=kind;self.record('last_backup',result)
+        return result
+
+    def recovery_limits(self,data,bin_dir):
+        # PostgreSQL WAL recovery cannot lower these shared-memory dimensions.
+        # Use only numeric allowlisted values, never replay source configuration.
+        names=','.join("'"+name+"'" for name in RECOVERY_LIMITS)
+        live=json.loads(self.sql("SELECT json_object_agg(name,setting::integer) FROM pg_settings WHERE name IN ("+names+")",'postgres'))
+        if not isinstance(live,dict) or set(live)!=set(RECOVERY_LIMITS):
+            raise rb.BackupError('PITR cannot verify primary recovery limits')
+        control=self.run([str(bin_dir/'pg_controldata'),str(data)]).stdout
+        limits={}
+        for name,(field,minimum) in RECOVERY_LIMITS.items():
+            value=live[name]
+            found=re.findall(r'^'+re.escape(field)+r' setting:\s*(.*?)\s*$',control,re.M)
+            if (type(value) is not int or not minimum<=value<=2147483647 or len(found)!=1
+                    or not re.fullmatch(r'[0-9]{1,10}',found[0])
+                    or not minimum<=int(found[0])<=2147483647):
+                raise rb.BackupError('PITR invalid numeric recovery limit: '+name)
+            limits[name]=max(value,int(found[0]))
+        return limits
+
+    def drill(self):
+        self.source();before=self.versions();source_id=self.sql('SELECT system_identifier FROM pg_control_system()','postgres')
+        target='omoba_pitr_'+uuid.uuid4().hex
