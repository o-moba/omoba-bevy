+        if failure:raise rb.BackupError(report.get('error','PITR drill failed')) from None
+        return report
+
+
+def health(ctx,remote=False):
+    pitr=Pitr(ctx.cfg,ctx.now);problems=pitr.problems();facts={}
+    if problems:return problems,facts
+    if remote:
+        try:
+            info=pitr.info()
+            if not info['backup'] or not 0 <= ctx.now()-max(b['timestamp']['stop'] for b in info['backup']) <= BACKUP_MAX_AGE:
+                raise rb.BackupError('PITR remote physical base is missing or stale')
+            facts['remote_cipher']=info['cipher']
+        except rb.BackupError as error:problems.append(('pitr-remote',str(error)))
+    try:state=pitr.state()
+    except rb.BackupError as error:return [('pitr-state',str(error))],facts
+    now=ctx.now()
+    for slot,age,code in [('last_check',CHECK_MAX_AGE,'archive'),('last_backup',BACKUP_MAX_AGE,'backup'),('last_drill_success',DRILL_MAX_AGE,'drill')]:
+        record=state.get(slot,{})
+        if not isinstance(record,dict):
+            problems.append(('pitr-state','PITR proof record is malformed'));continue
+        at=rb.parse_iso(record.get('at') or record.get('finished_at'))
+        if not record.get('ok') or at is None or not 0 <= now-at <= age:
+            problems.append(('pitr-'+code,f'PITR {code} has no recent successful proof'))
+        facts[slot]=record.get('at') or record.get('finished_at')
+    for slot in ('last_check','last_drill'):
+        record=state.get(slot,{})
+        if isinstance(record,dict) and record.get('ok') is False:problems.append(('pitr-failed',f'PITR {slot} failed; inspect the dedicated state and journal'))
+    return problems,facts
+
+
+def notify(cfg,error):
+    """A separate locked alert journal never overwrites long backup metadata."""
+    root=Path(cfg.backup_dir);root.mkdir(mode=0o700,parents=True,exist_ok=True)
+    fd=os.open(root/'pitr-notify.lock',os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW,0o600)
+    try:
+        fcntl.flock(fd,fcntl.LOCK_EX)
+        context=rb.Context(cfg,state_name='pitr-alerts.json',topic='WAL archive')
+        if error is None:context.resolve([])
+        else:
+            hidden=Pitr(cfg).hidden+cfg.secrets()
+            context.alert('pitr-archive',rb.redact(str(error),hidden))
+    finally:os.close(fd)
