+        self.engine('check',timeout=120)
+        info=self.info()
+        if not info['backup']:raise rb.BackupError('PITR drill has no physical base backup')
+        last=max(info['backup'],key=lambda value:value['timestamp']['stop'])
+        size=int(last['info']['size'])
+        if size<=0 or shutil.disk_usage(self.runtime).free < (1<<30)+2*size:raise rb.BackupError('PITR drill has insufficient space for an isolated restored cluster')
+        root=self.runtime/'drills';root.mkdir(mode=0o700,exist_ok=True)
+        work=Path(tempfile.mkdtemp(prefix='owned-',dir=root));data=work/'data';socket=work/'socket';log=work/'postgres.log'
+        owner=rb.db_user(self.cfg)
+        if 'user' in owner:os.chown(work,owner['user'],owner['group']);os.chown(root,owner['user'],owner['group'])
+        socket.mkdir(mode=0o700)
+        if 'user' in owner:os.chown(socket,owner['user'],owner['group'])
+        started=self.now();report={'ok':False,'started_at':rb.iso(started),'target':target,'target_lsn':target_lsn}
+        self.record('last_drill',report)
+        pg_ctl=None;failure=None
+        try:
+            self.engine('--pg1-path='+str(data),'--type=name','--target='+target,'--target-action=promote','restore',timeout=3*3600)
+            if (data/'standby.signal').exists() or not (data/'recovery.signal').is_file():raise rb.BackupError('PITR restore did not create isolated archive recovery')
+            auto=[]
+            for line in (data/'postgresql.auto.conf').read_text().splitlines():
+                match=re.match(r'^\s*([a-z_]+)\s*=',line)
+                if match and match.group(1) in RECOVERY_KEYS:auto.append(line)
+            if not any(line.lstrip().startswith('restore_command') for line in auto) or not any(target in line and line.lstrip().startswith('recovery_target_name') for line in auto):
+                raise rb.BackupError('PITR restore lost its named target/restore command')
+            major=(data/'PG_VERSION').read_text().strip()
+            if not re.fullmatch(r'\d{2}',major):raise rb.BackupError('PITR restore has an unsupported server version')
+            bin_dir=Path('/usr/lib/postgresql')/major/'bin'
+            if not (bin_dir/'pg_ctl').is_file():bin_dir=Path(rb.exe('pg_ctl')).parent
+            pg_ctl=str(bin_dir/'pg_ctl')
+            version=self.run([str(bin_dir/'postgres'),'--version']).stdout
+            if not re.search(r'\b'+major+r'\.',version):raise rb.BackupError('PITR drill binaries do not match the restored cluster major')
+            limits=self.recovery_limits(data,bin_dir)
+            report['recovery_limits']=limits
+            limit_config=''.join(name+'='+str(value)+'\n' for name,value in limits.items())
+            files={'postgresql.auto.conf':'\n'.join(auto)+'\n',
+                'postgresql.conf':f"listen_addresses=''\nport=6545\nunix_socket_directories='{socket}'\nshared_buffers='16MB'\n{limit_config}archive_mode=off\nssl=off\nshared_preload_libraries=''\n",
+                'pg_hba.conf':'local all all trust\n','pg_ident.conf':''}
+            for name,text in files.items():
