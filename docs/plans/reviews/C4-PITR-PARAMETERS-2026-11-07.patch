+            result=self.run([pg_ctl,'-D',str(data),'-l',str(log),'-w','-t','120','start'],timeout=130,check=False)
+            if result.returncode:raise rb.BackupError('PITR drill PostgreSQL did not start; target recovery was not accepted')
+            deadline=time.monotonic()+DRILL_TIMEOUT
