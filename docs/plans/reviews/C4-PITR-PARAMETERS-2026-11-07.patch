+++ b/ops/vps/ru/pgbackrest.conf.example
@@ -0,0 +1,38 @@
+# C4: pgBackRest>=2.58; placeholder only. Root:postgres0640; no real credential is shipped.
+# Fill the actual primary data path and independent RU storage before use.
+# S3 profile alternative is documented in README; strict TLS is mandatory.
+[global]
+repo1-type=sftp
+repo1-path=/omoba-ru/pitr
+repo1-sftp-host=CHANGE_ME
+repo1-sftp-host-user=CHANGE_ME
+repo1-sftp-host-port=22
+repo1-sftp-private-key-file=/etc/pgbackrest/sftp-key
+repo1-sftp-public-key-file=/etc/pgbackrest/sftp-key.pub
+repo1-sftp-host-key-check-type=strict
+repo1-sftp-host-key-hash-type=sha256
+repo1-sftp-known-host=/etc/pgbackrest/known_hosts
+repo1-cipher-type=aes-256-cbc
+repo1-cipher-pass=CHANGE_ME
+repo1-retention-full=3
+repo1-retention-diff=14
+archive-async=n
+archive-check=y
+archive-copy=y
+archive-mode-check=y
+archive-timeout=60
+process-max=1
+start-fast=y
+compress-type=gz
+compress-level=3
+io-timeout=30
+protocol-timeout=180
+lock-path=/var/lib/omoba-ru-pitr/lock
+log-path=/var/lib/omoba-ru-pitr/log
+spool-path=/var/lib/omoba-ru-pitr/spool
+log-level-file=off
+[omoba-ru]
+pg1-path=/var/lib/postgresql/CHANGE_ME/main
+pg1-socket-path=/var/run/postgresql
+pg1-port=5432
+pg1-user=postgres
