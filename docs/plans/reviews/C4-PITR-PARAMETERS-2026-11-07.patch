+
+class PitrTest(unittest.TestCase):
+    def setUp(self):
+        work=tempfile.TemporaryDirectory();self.addCleanup(work.cleanup);self.root=Path(work.name)
+        self.profile=self.root/'profile';self.profile.mkdir(mode=0o755);(self.profile/'empty').mkdir(mode=0o755)
+        self.runtime=self.root/'runtime';self.runtime.mkdir(mode=0o700)
+        for name in ('key','key.pub','known_hosts'):
