+    def fresh(self):
+        return rh.Host(self.root,run=self.run_os,sleep=self.sleep,resolve=self.fake.resolve,
+                       fetch=self.fake.fetch,root_uid=os.getuid(),now=lambda:self.clock)
+
+    def operation(self):
+        if not hasattr(self,'marker') or not self.marker.exists():return None
+        entries=list(self.marker.iterdir())
+        return entries[0].name if len(entries)==1 else None
+
+    def write_report(self,draining=True,operation=None,occupied=None,updated_ms=None):
+        self.capacity.write_text(json.dumps({'version':1,'updated_ms':self.clock*1000 if updated_ms is None else updated_ms,
+          'occupied':len(self.fake.extra_workers) if occupied is None else occupied,'draining':draining,
+          'drain_operation_id':self.operation() if operation is None else operation}))
+
+    def sleep(self,seconds):
+        self.clock+=seconds
+        self.sleeps+=1
+        if self.steps:
+            step=self.steps.pop(0)
+            if 'workers' in step:self.fake.extra_workers=list(step['workers'])
+            self.write_report(**{k:v for k,v in step.items() if k!='workers'})
+        elif hasattr(self,'capacity') and self.restart_ack and self.operation():
+            self.write_report()
+
+    def run_os(self,args,check=True,**kwargs):
+        snapshot={'args':list(args),'workers':list(self.fake.extra_workers),'operation':self.operation(),'at':self.clock}
+        self.events.append(snapshot)
+        if self.fail_new_start and args==['systemctl','restart','omoba-lobby-ru']:
+            self.fail_new_start=False
+            if check:raise SystemExit('injected new lobby start failure')
+            return subprocess.CompletedProcess(args,1,'','injected failure')
+        result=self.fake(args,check=check,**kwargs)
+        if (hasattr(self,'capacity') and self.restart_ack and self.operation()
+            and args in (['systemctl','restart','omoba-lobby-ru'],['systemctl','start','omoba-lobby-ru'])):
+            self.clock+=0.001
+            self.write_report()
+        return result
