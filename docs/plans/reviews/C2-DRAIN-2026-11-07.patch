@@ -0,0 +1,396 @@
+"""C2: real host controller against temporary files and simulated OS services.
+No SSH, systemd, production database or deployment is used by these tests.
+"""
+from pathlib import Path
+import contextlib
+import io
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+ROOT=Path(__file__).resolve().parents[1]
+sys.path[:0]=[str(ROOT/'scripts'),str(ROOT/'ops/vps/ru')]
+import test_ru_host as base
+rh=base.ru_host
+
+
+class DrainControllerTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.clock = 1_000_000.0
+        self.workers = [101]
+        self.host = rh.Host(root=self.temp.name, root_uid=os.getuid(), now=lambda: self.clock)
+        self.host.mutating = True
+        self.host.active = lambda unit: True
+        self.host.running_matches = lambda: list(self.workers)
+        self.host.sleep = self.sleep
+        self.marker = Path(self.host.p(rh.STATE + '/matches/drain'))
+        self.report_path = self.marker.parent / 'capacity.json'
+        self.marker.parent.mkdir(parents=True)
+        self.write_report()
+
+    def sleep(self, seconds):
+        self.clock += seconds
+
+    def write_report(self, **extra):
+        value = dict(version=1, updated_ms=self.clock*1000, occupied=len(self.workers), draining=False)
+        value.update(extra)
+        self.report_path.write_text(json.dumps(value))
+
+    def test_begin_is_no_replace_and_read_only_state_cannot_create_it(self):
+        self.host.mutating = False
+        with self.assertRaises(rh.Refused):
+            self.host.begin_drain()
+        self.assertFalse(self.marker.exists())
+        self.host.mutating = True
+        operation = self.host.begin_drain()
+        self.assertEqual(self.host.drain_marker(), {'active': True, 'operation_id': operation})
+        self.assertEqual(list(self.marker.iterdir())[0].stat().st_size, 0)
+        with self.assertRaises(rh.Refused):
+            self.host.begin_drain()
+        with self.assertRaises(rh.Refused):
+            self.host.cancel_drain('f'*32 if operation != 'f'*32 else 'e'*32)
+        self.assertEqual(self.host.drain_marker()['operation_id'], operation)
+        self.host.cancel_drain(operation)
+        self.assertFalse(self.marker.exists())
+
+    def test_wait_requires_exact_fresh_ack_zero_occupied_and_no_processes(self):
