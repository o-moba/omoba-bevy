// Open Omoba.xcodeproj, choose the Omoba scheme and Any iOS Device (arm64).
PRODUCT_NAME = OmobaBeta
PRODUCT_BUNDLE_IDENTIFIER = space.ekza.omoba.beta
EXECUTABLE_NAME = client
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos
ARCHS = arm64
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 15.0
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 12
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = $(DERIVED_FILE_DIR)/Omoba-Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
ENABLE_BITCODE = NO
ALWAYS_SEARCH_USER_PATHS = NO
// Cargo supplies and validates its own complete dSYM. Xcode must not regenerate
// or strip the Rust executable; the Archive scheme retains this bundle.
DEBUG_INFORMATION_FORMAT = dwarf
DWARF_DSYM_FILE_NAME = $(FULL_PRODUCT_NAME).dSYM
STRIP_INSTALLED_PRODUCT = NO
COPY_PHASE_STRIP = NO
SKIP_INSTALL = NO
INSTALL_PATH = /Applications
// The existing iOS builder uses dev with opt-level 1 / dependencies opt-level 3.
// Set release locally for a fully optimized Rust build (separate compile cache).
OMOBA_CARGO_PROFILE = dev
// Optional, ignored local overrides for team, build number, server or cache.
#include? "Omoba.local.xcconfig"
