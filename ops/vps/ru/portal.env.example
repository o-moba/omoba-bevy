# RU player portal (omoba-web, `output: standalone`), self-hosted in Russia next to
# the Account API — see omoba-web docs/markets.md. Never commit real values.
OMOBA_MARKET=ru
OMOBA_PORTAL_ORIGIN=https://app.ru.omoba.io
OMOBA_ACCOUNT_MODE=enabled
OMOBA_ACCOUNT_API_URL=https://account.ru.omoba.io
# Same value as the ingress fragment's portal key (openssl rand -hex 32).
OMOBA_ACCOUNT_INGRESS_KEY=CHANGE_ME_64_HEX
OMOBA_VKID_CLIENT_ID=CHANGE_ME
PORT=3010
