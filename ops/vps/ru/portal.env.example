# RU player portal (omoba-web, `output: standalone`), self-hosted in Russia next to
# the Account API — see omoba-web docs/markets.md. Never commit real values.
# ru_host.py bootstrap writes /opt/omoba-ru/portal.env (root, 0600) from this file and
# fills in --vkid-client-id; omoba-portal-ru.service sets HOSTNAME=127.0.0.1 itself.
#
# Topology (README.md, "Topology"): Caddy serves omoba.ru and overwrites
# X-Real-IP with the browser's address; the portal listens on 127.0.0.1:3010 and
# calls the Account API directly on loopback, forwarding that address. No portal
# ingress key: account.omoba.ru refuses every portal route. The portal refuses to
# serve when this is inconsistent (an API that is not on loopback without
# OMOBA_ACCOUNT_INGRESS_KEY, or the loopback API without OMOBA_TRUST_LOOPBACK_PROXY=1).
OMOBA_MARKET=ru
OMOBA_PORTAL_ORIGIN=https://omoba.ru
OMOBA_ACCOUNT_MODE=enabled
# The same address as OMOBA_ACCOUNT_BIND in account-api.env.
OMOBA_ACCOUNT_API_URL=http://127.0.0.1:40550
# Trust and forward Caddy's X-Real-IP; the Account API sets the same flag.
OMOBA_TRUST_LOOPBACK_PROXY=1
OMOBA_VKID_CLIENT_ID=CHANGE_ME
# No OMOBA_SITE_URL: the RU landing is this portal's own guest home at / (LR-22), so its
# "OMOBA website" links lead there, and the portal refuses to start with one set.
PORT=3010
