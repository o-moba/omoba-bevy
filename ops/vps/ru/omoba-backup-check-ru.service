# Hourly backup health check of the RU host (LR-03): alerts (journal, Telegram when
# configured, each problem at most every 6 h) when no backup succeeded for 26 h, the last
# run or drill failed, no drill succeeded for 35 days, the secrets escrow is missing or
# stale, or backup.env is incomplete. The unit fails while a problem lasts.
# Installed by ops/vps/ru/ru_host.py bootstrap (README.md, "Backups, escrow and restore drill").
[Unit]
Description=OMOBA RU backup health check

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/omoba-ru/backup/ru_backup.py check --alert
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/backups/omoba-ru
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
