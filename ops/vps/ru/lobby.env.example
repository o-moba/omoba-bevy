# /opt/omoba-ru/lobby.env — root-only (chmod 600). Never commit real values.
# ru_host.py bootstrap writes it on the host from this file: it generates the
# password and fills in $RU_IP. It must not repeat a setting of omoba-lobby-ru.service
# (an EnvironmentFile overrides the unit's Environment= lines).
# Game runtime role on the RU PostgreSQL (in Russia, 152-FZ).
OMOBA_DATABASE_URL=postgres://omoba_game:CHANGE_ME@127.0.0.1:5432/omoba_ru
# This host's public IPv4: clients reach the match workers on it (UDP 41000+).
OMOBA_MATCH_PUBLIC_HOST=CHANGE_ME_PUBLIC_IPV4
# Per-source admission (README "Admission limits", LR-16). Russian mobile operators
# put many players behind one IPv4 (carrier-grade NAT), so one source address may
# hold up to 256 players and 8 arenas, and the probe budgets leave room for them.
# The match workers inherit these; a malformed value stops the lobby. A host whose
# file predates a line gets it from `ru_host.py bootstrap --apply`.
OMOBA_LIMIT_ENDPOINTS_PER_IP=256
OMOBA_LIMIT_ARENAS_PER_IP=8
OMOBA_LIMIT_PROBES_PER_IP=64
OMOBA_LIMIT_PROBES_PER_NETWORK=256
OMOBA_LIMIT_PROBES_GLOBAL=512
OMOBA_LIMIT_PROBES_NEW_RESERVE=128
OMOBA_LIMIT_NEW_PROFILES_PER_IP=40
