# Every night at 00:30 UTC (03:30 Moscow), within 15 minutes; a night the host was down
# runs at the next boot (Persistent=true). LR-03.
[Unit]
Description=Nightly OMOBA RU encrypted off-host backup

[Timer]
OnCalendar=*-*-* 00:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
