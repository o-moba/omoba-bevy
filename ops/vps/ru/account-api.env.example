# /opt/omoba-ru/account-api.env — root-only (chmod 600). Never commit real values.
# ru_host.py bootstrap writes it on the host from this file: it generates the
# database password and both secrets, and fills in --vkid-client-id.
# Portal runtime role on the RU PostgreSQL (in Russia, 152-FZ).
OMOBA_DATABASE_URL=postgres://omoba_portal:CHANGE_ME@127.0.0.1:5432/omoba_ru
OMOBA_PORTAL_ORIGIN=https://omoba.ru
# openssl rand -hex 32 ; keep across restarts (rotation logs every browser out).
OMOBA_PORTAL_SECRET=CHANGE_ME_64_HEX
# VK ID app id (id.vk.ru → your web app). The same id goes to the portal.
OMOBA_VKID_CLIENT_ID=CHANGE_ME
# openssl rand -hex 32 ; NEVER rotate: it keys every stored VK identity.
OMOBA_SOCIAL_SECRET=CHANGE_ME_64_HEX
# Optional: curated downloads shown on the portal (account-api/README.md#downloads).
# OMOBA_RELEASE_CATALOG=/opt/omoba-ru/releases.json
# Loopback only. Two local clients call it (README.md, "Topology"): Caddy for the
# game's native routes and the portal (OMOBA_ACCOUNT_API_URL) for everything else.
OMOBA_ACCOUNT_BIND=127.0.0.1:40550
# Per-IP limits use X-Real-IP from those loopback clients: Caddy overwrites it with
# the game's address, the portal forwards the browser's. A loopback request without
# it is refused, so no local caller can share one bucket by accident.
OMOBA_TRUST_LOOPBACK_PROXY=1
