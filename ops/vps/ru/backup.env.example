# /opt/omoba-ru/backup.env — root-only (chmod 600). Never commit real values.
# ru_host.py bootstrap writes it from this file once and never replaces it; the owner
# fills in the storage and the keys (README.md, "Backups, escrow and restore drill").
# ru_backup.py reads only this file; `ru_backup.py config` checks it.
#
# Off-host storage in Russia (152-FZ): the owner provides it. One of
#   s3://<bucket>/<prefix>                     S3-compatible object storage
#   sftp://<user>@<host>[:<port>]/<folder>     an SFTP account on another server
OMOBA_BACKUP_TARGET=CHANGE_ME
#
# s3:// only: the provider's https origin and region, and a key that may list, read,
# write and delete in the bucket (no other bucket). Yandex Object Storage, for example,
# is https://storage.yandexcloud.net with ru-central1; other providers (Selectel, VK
# Cloud, ...) publish their own origin and region. Path-style requests, SigV4.
#OMOBA_BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
#OMOBA_BACKUP_S3_REGION=ru-central1
#OMOBA_BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
#OMOBA_BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
#
# sftp:// only: the login key (root 0600) and the server's pinned host key
# (ssh-keyscan -p <port> <host>, fingerprint compared with the provider's).
#OMOBA_BACKUP_SSH_KEY=/opt/omoba-ru/backup-keys/ssh_key
#OMOBA_BACKUP_SSH_KNOWN_HOSTS=/opt/omoba-ru/backup-keys/known_hosts
#
# GnuPG keys (`ru_backup.py keygen` on the Mac). Sets are encrypted to the public key and
# signed with the secret key (root 0600), which the monthly restore drill also decrypts
# with; fetch and the drill refuse a set it did not sign. The escrow holder keeps the
# secret key offline as well: without it no backup can be read.
OMOBA_BACKUP_GPG_RECIPIENT_FILE=/opt/omoba-ru/backup-keys/backup-public.asc
OMOBA_BACKUP_GPG_IDENTITY_FILE=/opt/omoba-ru/backup-keys/backup-secret.asc
#
# Retention: the storage keeps the newest set of each of the last 14 days with a set and
# of each of the last 8 weeks; this host keeps the newest 2.
OMOBA_BACKUP_KEEP_DAILY=14
OMOBA_BACKUP_KEEP_WEEKLY=8
OMOBA_BACKUP_KEEP_LOCAL=2
#
# Alerts: the RU host's one Telegram bot lives in /opt/omoba-ru/alerts.env (LR-17,
# README.md "Monitoring and alerts") and covers the backups too. Set these two lines only to
# send the backup alerts to another chat; without any bot, alerts go to the journal only
# (journalctl -u omoba-backup-ru -u omoba-backup-check-ru).
#OMOBA_TELEGRAM_BOT_TOKEN=CHANGE_ME
#OMOBA_TELEGRAM_CHAT_ID=CHANGE_ME
