# RU market lobby (docs/markets.md). Install `omoba-server` from the RU server bundle
# (python3 scripts/release.py build server --market ru) under /opt/omoba-ru/current.
# A build for another market must never run here: the RU server has no Ekza
# registry or passport and grants no paid cosmetics.
# Installed and shipped by ops/vps/ru/ru_host.py (README.md). The lobby needs the
# career database at start, so it starts after the local PostgreSQL and never stops
# retrying: a crash or a slow database restarts it every 5 s, without a start limit.
[Unit]
Description=OMOBA RU lobby and bounded match workers
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=0
# Any failure (also each crash before the restart) alerts the owner (LR-17).
OnFailure=omoba-alert-ru@%n.service

[Service]
Type=simple
User=omoba-ru
Group=omoba-ru
WorkingDirectory=/var/lib/omoba-ru
# OMOBA_DATABASE_URL (game runtime role) and OMOBA_MATCH_PUBLIC_HOST (this host's
# public IPv4, the address clients reach match workers on). Written on the host by
# ru_host.py bootstrap (root, 0600); it must not repeat a setting of this unit.
EnvironmentFile=/opt/omoba-ru/lobby.env
Environment=SERVER_ADDR=0.0.0.0:4000
Environment=OMOBA_SERVER_ROLE=lobby
Environment=OMOBA_MATCH_MODE=release
Environment=OMOBA_TEAM_SIZE=5
Environment=OMOBA_MATCH_ROOT=/var/lib/omoba-ru/matches
Environment=OMOBA_CAREER_OUTBOX=/var/lib/omoba-ru/lobby-outbox
Environment=OMOBA_MATCH_BIND_IP=0.0.0.0
# 16 arenas on UDP 41000-41015 (README "Arena capacity"); nftables-omoba.conf's
# OMOBA_ARENA_PORTS must cover the same range, and ru_host.py refuses a kit where
# they differ.
Environment=OMOBA_MATCH_FIRST_PORT=41000
Environment=OMOBA_MATCH_CAPACITY=16
Environment=OMOBA_MATCH_EXECUTABLE=/opt/omoba-ru/current/omoba-server
# Text chat off at launch (owner default O-9, LR-15); reactions stay. Match workers
# inherit it. Turning it on needs the owner's legal check (ОРИ, 149-FZ) and changes
# ru_host.py's unit rule too. `omoba-account-api chat off` is the runtime kill switch.
Environment=OMOBA_CHAT=off
ExecStart=/opt/omoba-ru/current/omoba-server
Restart=always
RestartSec=5
# A stop or restart signals the lobby only: live match workers keep running in the
# unit's cgroup and the next lobby adopts them from their manifests (README "Install
# and update"). They stay under the limits below.
KillMode=process
SendSIGHUP=no
TimeoutStopSec=20
# Formula values for 16 arenas, pending the LR-09 measurement (README "Arena
# capacity"): MemoryMax = 16 MiB x arenas + 200 MiB, MemoryHigh = MemoryMax - 50 MiB,
# TasksMax >= 3 x arenas + 16 (set with headroom), CPUQuota = 190% of the 2 vCPU.
MemoryHigh=450M
MemoryMax=500M
CPUQuota=190%
TasksMax=96
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/omoba-ru
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
