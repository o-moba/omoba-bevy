# /opt/omoba-ru/alerts.env — root-only (chmod 600). Never commit real values.
# ru_host.py bootstrap writes it from this file once and never replaces it. ru_monitor.py
# reads only this file (README.md, "Monitoring and alerts"); `ru_monitor.py check` and
# `ru_monitor.py test-alert` check it.
#
# The RU host's one Telegram bot (launch-readiness defaults): unit failures, disk, match
# workers and, unless backup.env names its own, the backup alerts (ru_backup.py). Without
# both lines, alerts go to the journal only. The external probe (ops/probe) uses the same bot.
#OMOBA_TELEGRAM_BOT_TOKEN=CHANGE_ME
#OMOBA_TELEGRAM_CHAT_ID=CHANGE_ME
#
# Alert when a filesystem the host writes to has less free space than this (percent).
OMOBA_ALERT_DISK_MIN_FREE_PERCENT=15
# Alert when a live match worker has written no heartbeat for this long (seconds); the
# lobby itself relaunches a worker after 100 s.
OMOBA_ALERT_WORKER_STALE_SECONDS=300
# Alert when players have waited this long for a free arena (seconds): every arena busy
# while a ready roster waits, from the lobby's capacity.json (LR-09). Raise the capacity
# only after checking CPU and memory (README.md, "Arena capacity").
OMOBA_ALERT_CAPACITY_WAIT_SECONDS=120
# While a problem lasts, remind every N minutes; a failed timer job (backup, drill, backup
# check, whose tool reports the details itself) every N hours.
OMOBA_ALERT_REPEAT_MINUTES=60
OMOBA_ALERT_JOB_REPEAT_HOURS=24
# Say "resolved" once a problem has not been seen for this long (minutes).
OMOBA_ALERT_RECOVERY_MINUTES=15
