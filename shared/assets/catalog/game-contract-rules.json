{
  "schema": "omoba.game-contract-rules.v1",
  "license": "CC0-1.0",
  "customizableVersion": "1",
  "roles": {
    "idle": { "customizableFrom": "1", "reserved": false, "window": { "minSecs": 1.0, "maxSecs": 4.0 } },
    "run": { "customizableFrom": "1", "reserved": false, "window": { "minSecs": 0.4, "maxSecs": 1.2 } },
    "walk": { "customizableFrom": null, "reserved": true, "window": { "minSecs": 0.8, "maxSecs": 2.0 } },
    "death": { "customizableFrom": "1", "reserved": false, "window": { "minSecs": 0.5, "maxSecs": 3.0 } },
    "basic": { "customizableFrom": "1", "reserved": false, "window": { "minSecs": 0.15, "maxSecs": 1.2 } },
    "release": { "customizableFrom": "1", "reserved": false, "window": { "minSecs": 0.15, "maxSecs": 1.2 } },
    "recast": { "customizableFrom": "1", "reserved": false, "window": { "minSecs": 0.15, "maxSecs": 1.2 } },
    "windup": { "customizableFrom": "1.1", "reserved": false, "window": { "minSecs": 0.3, "maxSecs": 2.0 } }
  },
  "packaging": { "characterMaxFills": 48 },
  "rules": [
    { "id": "pack.manifest", "severity": "error", "scope": "package", "checkedBy": ["tool", "hub", "builder", "game"],
      "params": { "key": "ekza_package_v1", "schema": "ekza.package.v1" } },
    { "id": "pack.contract", "severity": "error", "scope": "package", "checkedBy": ["tool", "hub", "builder", "game"],
      "params": {} },
    { "id": "pack.target", "severity": "error", "scope": "package", "checkedBy": ["tool", "hub", "builder", "game"],
      "params": {} },
    { "id": "pack.bytes", "severity": "error", "scope": "package", "checkedBy": ["tool", "hub", "builder", "game"],
      "params": { "from": "packaging", "maxAnimationBytes": 4194304 } },
    { "id": "pack.slot-known", "severity": "error", "scope": "package", "checkedBy": ["tool", "hub", "builder", "game"],
      "params": {} },
    { "id": "pack.ref", "severity": "error", "scope": "package", "checkedBy": ["tool", "hub", "builder", "game"],
      "params": { "animationNameEqualsSlot": true, "nodeNameEqualsRootName": true } },
    { "id": "pack.unreferenced", "severity": "warning", "scope": "package", "checkedBy": ["tool", "hub", "builder", "game"],
      "params": {} },
    { "id": "rig.humanoid", "severity": "error", "scope": "rig", "checkedBy": ["tool", "builder", "game"],
      "params": { "from": "rigs" } },
    { "id": "clip.channels", "severity": "error", "scope": "animation", "checkedBy": ["tool", "builder", "game"],
      "params": { "rotation": "driven-bones", "translation": ["hips"], "scale": false, "weights": false,
                  "vrm1BoneMap": { "leftThumbMetacarpal": "leftThumbProximal", "leftThumbProximal": "leftThumbIntermediate",
                                   "rightThumbMetacarpal": "rightThumbProximal", "rightThumbProximal": "rightThumbIntermediate" } } },
    { "id": "clip.sampler", "severity": "error", "scope": "animation", "checkedBy": ["tool", "builder", "game"],
      "params": { "interpolation": ["LINEAR", "STEP"], "startsAtSecs": 0.0, "timeEpsilonSecs": 0.0001, "unitQuatEpsilon": 0.001 } },
    { "id": "clip.keys", "severity": "error", "scope": "animation", "checkedBy": ["tool", "builder", "game"],
      "params": { "maxKeysPerChannel": 4096, "maxSampleRateHz": 60 } },
    { "id": "clip.duration", "severity": "error", "scope": "animation", "checkedBy": ["tool", "builder", "game"],
      "params": { "from": "slot.animation.window" } },
    { "id": "clip.in-place", "severity": "error", "scope": "animation", "checkedBy": ["tool", "builder", "game"],
      "params": { "unit": "legLength", "reference": "rest-pose", "maxHorizontal": 0.15, "maxHorizontalHold": 0.75,
                  "maxUp": 1.5, "maxDown": 1.25 } },
    { "id": "clip.loop-closure", "severity": "error", "scope": "animation", "checkedBy": ["tool", "builder", "game"],
      "params": { "unit": "legLength", "maxBoneDegrees": 2.0, "maxHipsOffset": 0.01 } },
    { "id": "clip.markers", "severity": "error", "scope": "animation", "checkedBy": ["tool", "builder", "game"],
      "params": { "from": "slot.animation.markers", "toleranceSecs": 0.0001, "metaKey": "ekza_animation_v1" } },
    { "id": "clip.min-interval", "severity": "warning", "scope": "animation", "checkedBy": ["tool", "builder", "game"],
      "params": { "from": "slot.animation.minIntervalSecs" } }
  ]
}
